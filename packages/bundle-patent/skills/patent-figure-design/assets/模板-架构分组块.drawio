        <mxCell id="ag3" value="成员 C" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000" vertex="1" parent="1"><mxGeometry x="60" y="260" width="140" height="50" as="geometry"/></mxCell>
