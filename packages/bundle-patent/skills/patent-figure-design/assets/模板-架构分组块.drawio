        <mxCell id="tab" value="登记表&#10;成员A：其输入/状态&#10;成员B：其输入/状态&#10;成员C：其输入/状态" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000" vertex="1" parent="1"><mxGeometry x="320" y="100" width="240" height="110" as="geometry"/></mxCell>
        <mxCell id="det" value="判定器&#10;（判定依据一句话）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000" vertex="1" parent="1"><mxGeometry x="320" y="250" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="g3" value="结果侧" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;verticalAlign=top;fontStyle=1" vertex="1" parent="1"><mxGeometry x="680" y="60" width="180" height="300" as="geometry"/></mxCell>
