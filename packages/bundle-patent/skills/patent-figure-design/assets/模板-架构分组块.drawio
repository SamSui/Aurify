<mxfile host="app.diagrams.net">
  <diagram id="tpl-arch" name="架构分组块">
    <mxGraphModel dx="900" dy="700" grid="0" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="900" pageHeight="460" math="0" shadow="0">
      <root>
