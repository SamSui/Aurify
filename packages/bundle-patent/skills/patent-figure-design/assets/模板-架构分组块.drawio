        <mxCell id="1" parent="0"/>
        <mxCell id="g1" value="角色/来源侧" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;verticalAlign=top;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="60" width="180" height="300" as="geometry"/></mxCell>
        <mxCell id="ag1" value="成员 A" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000" vertex="1" parent="1"><mxGeometry x="60" y="100" width="140" height="50" as="geometry"/></mxCell>
