        <mxCell id="e5" value="条件一（通过）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontColor=#000000;exitX=1;exitY=0.25;entryX=0;entryY=0.5" edge="1" parent="1" source="det" target="ok"><mxGeometry relative="1" as="geometry"/></mxCell>
