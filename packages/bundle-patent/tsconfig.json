{
  "extends": "../../../tsconfig.base.client.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib/types",
    // The host half (skills loader, invariant) imports node builtins; the
    // client sources stay browser-pure and the artifact purity gate checks
    // the emitted bundle, not the shared program.
    "types": ["node"]
  },
  "include": [
    "src"
  ],
  "references": [
    {
      "path": "../../../vendor/cordis"
    },
    {
