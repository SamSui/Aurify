    },
    {
      "path": "../../skill/skill"
    },
    {
      "path": "../../runtime-diagnostics/invariants"
    },
    {
      "path": "../../api/remotes/tsconfig.client.json"
    },
    {
      "path": "../../client/locale"
    },
    {
      "path": "../../client/ui-sidebar-right"
    },
    {
      "path": "../../client/ui-primitives"
    },
    {
      "path": "../../client/ui-renderer"
    },
    {
      "path": "../../client/ui-settings"
    },
    {
      "path": "../../client/ui-slots"
    },
    {
      "path": "../../client/ui-tool"
    }
  ]
}
